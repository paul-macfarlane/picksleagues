                "minimum": 0
              },
              "unexpectedCount": {
                "type": "integer",
                "minimum": 0
              },
              "mismatchCount": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "expectedCount",
              "storedCount",
              "missingCount",
              "unexpectedCount",
              "mismatchCount"
            ]
          },
          "standings": {
            "type": [
