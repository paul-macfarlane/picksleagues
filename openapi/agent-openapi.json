{
  "openapi": "3.1.0",
  "info": {
    "title": "Picks Leagues Agent API",
    "version": "1.0.0"
  },
  "components": {
    "securitySchemes": {
      "AgentBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "AgentSystemResponse": {
        "type": "object",
        "properties": {
          "environment": {
            "type": "string",
            "enum": [
              "local",
              "staging",
              "production"
            ]
          },
          "serverTime": {
            "type": "string",
            "format": "date-time"
          },
          "supportedSports": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Sport"
            },
            "maxItems": 2
          },
          "seasonId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "seasonYear": {
            "type": "integer"
          },
          "provisional": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "currentWeekId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "dataUpdatedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "anomalies": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "no_season",
                "no_games",
                "missing_spread",
                "final_without_score",
                "scheduled_after_kickoff",
                "ungraded_resolved_picks",
                "inconsistent_rows",
                "missing_standings",
                "unsupported_mode"
              ]
            },
            "maxItems": 9
          }
        },
        "required": [
          "environment",
          "serverTime",
          "supportedSports",
          "seasonId",
          "seasonYear",
          "provisional",
          "currentWeekId",
          "dataUpdatedAt",
          "anomalies"
        ]
      },
      "Sport": {
        "type": "string",
        "enum": [
          "nfl",
          "ncaamb"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "error",
          "message"
        ]
      },
      "AgentWeekResponse": {
        "type": "object",
        "properties": {
          "weekId": {
            "type": "string",
            "format": "uuid"
          },
          "seasonId": {
            "type": "string",
            "format": "uuid"
          },
          "weekType": {
            "$ref": "#/components/schemas/WeekType"
          },
          "weekNumber": {
            "type": "integer"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          },
          "gameCounts": {
            "type": "object",
            "properties": {
              "scheduled": {
                "type": "integer",
                "minimum": 0
              },
              "in_progress": {
                "type": "integer",
                "minimum": 0
              },
              "final": {
                "type": "integer",
                "minimum": 0
              },
              "postponed": {
                "type": "integer",
                "minimum": 0
              },
              "cancelled": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "scheduled",
              "in_progress",
              "final",
              "postponed",
              "cancelled"
            ]
          },
          "missingSpreadCount": {
            "type": "integer",
            "minimum": 0
          },
          "finalWithoutScoreCount": {
            "type": "integer",
            "minimum": 0
          },
          "scheduledAfterKickoffCount": {
            "type": "integer",
            "minimum": 0
          },
          "dataUpdatedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "anomalies": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "no_season",
                "no_games",
                "missing_spread",
                "final_without_score",
                "scheduled_after_kickoff",
                "ungraded_resolved_picks",
                "inconsistent_rows",
                "missing_standings",
                "unsupported_mode"
              ]
            },
            "maxItems": 9
          }
        },
        "required": [
          "weekId",
          "seasonId",
          "weekType",
          "weekNumber",
          "startsAt",
          "endsAt",
          "gameCounts",
          "missingSpreadCount",
          "finalWithoutScoreCount",
          "scheduledAfterKickoffCount",
          "dataUpdatedAt",
          "anomalies"
