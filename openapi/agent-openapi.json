  "paths": {
    "/api/agent/v1/system": {
      "get": {
        "operationId": "agentSystem",
        "security": [
          {
            "AgentBearer": []
          }
        ],
        "summary": "Environment and current NFL ingestion diagnostics",
        "responses": {
          "200": {
            "description": "Technical system snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentSystemResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid diagnostic identifier",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "No valid session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Diagnostic resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Server misconfiguration — structurally unreachable outside generate-openapi.ts, which builds the app with no deps and only ever requests the spec document, never invoking this handler.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
