            "minimum": 0
          },
          "missingStandingCount": {
            "type": "integer",
            "minimum": 0
          },
          "inconsistentRowCount": {
            "type": "integer",
            "minimum": 0
          },
          "duplicateRowCount": {
            "type": "integer",
            "minimum": 0
