{
  "openapi": "3.1.0",
  "info": {
    "title": "Picks Leagues API",
    "version": "0.1.0"
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "MeResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "username": {
            "$ref": "#/components/schemas/NullableUsername"
          },
          "displayName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "image": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "username",
          "displayName",
          "email",
          "image"
        ]
      },
      "NullableUsername": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^[a-z0-9_]{3,20}$"
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "error",
          "message"
        ]
      },
      "UpdateMeRequest": {
        "type": "object",
        "properties": {
          "username": {
            "$ref": "#/components/schemas/Username"
          },
          "displayName": {
            "$ref": "#/components/schemas/DisplayName"
          }
        }
      },
      "Username": {
        "type": "string",
        "pattern": "^[a-z0-9_]{3,20}$"
      },
      "DisplayName": {
        "type": "string",
        "minLength": 1,
        "maxLength": 50
      },
      "JobRunResponse": {
        "type": "object",
        "properties": {
          "job": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ]
          },
          "durationMs": {
            "type": "number"
          },
          "details": {
            "type": "object",
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            }
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "job",
          "status",
          "durationMs"
        ]
      },
      "WeekType": {
        "type": "string",
        "enum": [
          "regular",
          "postseason"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Liveness check",
        "responses": {
          "200": {
            "description": "Service is up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "operationId": "getMe",
        "summary": "Get the caller's own profile",
        "responses": {
          "200": {
            "description": "The caller's profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "No valid session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Server misconfiguration — structurally unreachable outside generate-openapi.ts, which builds the app with no deps and only ever requests the spec document, never invoking this handler.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "updateMe",
        "summary": "Claim/change the caller's username and/or edit their display name",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateMeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profile updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "400": {
            "description": "No fields supplied, or a supplied field fails its format rule",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "No valid session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Username already taken by another user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Server misconfiguration — structurally unreachable outside generate-openapi.ts, which builds the app with no deps and only ever requests the spec document, never invoking this handler.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteMe",
        "summary": "Delete (anonymize) the caller's own account",
        "responses": {
          "204": {
            "description": "Account deleted — profile anonymized, OAuth identities and sessions removed"
          },
          "401": {
            "description": "No valid session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Server misconfiguration — structurally unreachable outside generate-openapi.ts, which builds the app with no deps and only ever requests the spec document, never invoking this handler.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/nfl/sync-schedule": {
      "post": {
        "operationId": "runNflSyncSchedule",
        "summary": "Ingest the NFL schedule (regular season + postseason) into our tables",
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 2000,
              "maximum": 2100
            },
            "required": false,
            "name": "season",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 18
            },
            "required": false,
            "name": "week",
            "in": "query"
          },
          {
            "schema": {
              "$ref": "#/components/schemas/WeekType"
            },
            "required": false,
            "name": "weekType",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Job completed — counters in `details`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobRunResponse"
                }
              }
            }
          },
          "400": {
            "description": "A supplied query param (season/week) fails its format rule",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong x-job-secret header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Job failed, or a dependency is not configured — same envelope either way",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobRunResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/nfl/sync-odds": {
      "post": {
        "operationId": "runNflSyncOdds",
        "summary": "Snapshot spreads for unstarted games in the current NFL week",
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 2000,
              "maximum": 2100
            },
            "required": false,
            "name": "season",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 18
            },
            "required": false,
            "name": "week",
            "in": "query"
          },
          {
            "schema": {
              "$ref": "#/components/schemas/WeekType"
            },
            "required": false,
            "name": "weekType",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Job completed — counters in `details`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobRunResponse"
                }
              }
            }
          },
          "400": {
            "description": "A supplied query param (season/week) fails its format rule",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong x-job-secret header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Job failed, or a dependency is not configured — same envelope either way",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobRunResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/nfl/sync-scores": {
      "post": {
        "operationId": "runNflSyncScores",
        "summary": "Refresh live scores/statuses for in-flight NFL games from the provider",
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 2000,
              "maximum": 2100
            },
            "required": false,
            "name": "season",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 18
            },
            "required": false,
            "name": "week",
            "in": "query"
          },
          {
            "schema": {
              "$ref": "#/components/schemas/WeekType"
            },
            "required": false,
            "name": "weekType",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Job completed — counters in `details`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobRunResponse"
                }
              }
            }
          },
          "400": {
            "description": "A supplied query param (season/week) fails its format rule",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong x-job-secret header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Job failed, or a dependency is not configured — same envelope either way",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobRunResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
