{
  "openapi": "3.1.0",
  "info": {
    "title": "Picks Leagues API",
    "version": "0.1.0"
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "MeResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "username": {
            "$ref": "#/components/schemas/NullableUsername"
          },
          "displayName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "image": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "username",
          "displayName",
          "email",
          "image"
        ]
      },
      "NullableUsername": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^[a-z0-9_]{3,20}$"
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "error",
          "message"
        ]
      },
      "UpdateMeRequest": {
        "type": "object",
        "properties": {
          "username": {
            "$ref": "#/components/schemas/Username"
          },
          "displayName": {
            "$ref": "#/components/schemas/DisplayName"
          }
        }
      },
      "Username": {
        "type": "string",
        "pattern": "^[a-z0-9_]{3,20}$"
      },
      "DisplayName": {
        "type": "string",
        "minLength": 1,
        "maxLength": 50
      },
      "JobRunResponse": {
        "type": "object",
        "properties": {
          "job": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ]
          },
          "durationMs": {
            "type": "number"
          },
          "details": {
            "type": "object",
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            }
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "job",
          "status",
          "durationMs"
        ]
      },
      "WeekType": {
        "type": "string",
        "enum": [
          "regular",
          "postseason"
        ]
      },
      "LeagueResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "$ref": "#/components/schemas/LeagueName"
          },
          "mode": {
            "$ref": "#/components/schemas/LeagueMode"
          },
          "visibility": {
            "$ref": "#/components/schemas/LeagueVisibility"
          },
          "status": {
            "$ref": "#/components/schemas/LeagueStatus"
          },
          "seasonYear": {
            "type": "integer"
          },
          "settings": {
            "$ref": "#/components/schemas/LeagueSettings"
          },
          "startsAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "myRole": {
            "$ref": "#/components/schemas/MemberRole"
          },
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LeagueMember"
            }
          }
        },
        "required": [
          "id",
          "name",
          "mode",
          "visibility",
          "status",
          "seasonYear",
          "settings",
          "startsAt",
          "myRole",
          "members"
        ]
      },
      "LeagueName": {
        "type": "string",
        "minLength": 1,
        "maxLength": 50
      },
      "LeagueMode": {
        "type": "string",
        "enum": [
          "pickem",
          "elimination",
          "march_madness"
        ]
      },
      "LeagueVisibility": {
        "type": "string",
        "enum": [
          "public",
          "private"
        ]
      },
      "LeagueStatus": {
        "type": "string",
        "enum": [
          "active",
          "concluded"
        ]
      },
      "LeagueSettings": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/PickemSettings"
          },
          {
            "$ref": "#/components/schemas/EliminationSettings"
          },
          {
            "type": "object",
            "properties": {
              "maxBracketsPerMember": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10,
                "default": 5
              },
              "scoringModel": {
                "type": "string",
                "enum": [
                  "standard_doubling"
                ]
              }
            },
            "required": [
              "scoringModel"
            ]
          },
          {
            "type": "object",
            "properties": {
              "maxBracketsPerMember": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10,
                "default": 5
              },
              "scoringModel": {
                "type": "string",
                "enum": [
                  "custom"
                ]
              },
              "roundValues": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "required": [
              "scoringModel",
              "roundValues"
            ]
          }
        ]
      },
      "PickemSettings": {
        "type": "object",
        "properties": {
          "startWeek": {
            "$ref": "#/components/schemas/NflWeekRef"
          },
          "endWeek": {
            "$ref": "#/components/schemas/NflWeekRef"
          },
          "pickType": {
            "$ref": "#/components/schemas/PickType"
          },
          "picksPerWeek": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16,
            "default": 5
          },
          "pushTieResolution": {
            "$ref": "#/components/schemas/PickemPushTieResolution"
          }
        },
        "required": [
          "startWeek",
          "endWeek",
          "pickType"
        ]
      },
      "NflWeekRef": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "regular"
                ]
              },
              "number": {
                "type": "integer",
                "minimum": 1,
                "maximum": 18
              }
            },
            "required": [
              "type",
              "number"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "postseason"
                ]
              },
              "number": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4
              }
            },
            "required": [
              "type",
              "number"
            ]
          }
        ]
      },
      "PickType": {
        "type": "string",
        "enum": [
          "straight_up",
          "against_the_spread"
        ]
      },
      "PickemPushTieResolution": {
        "type": "string",
        "enum": [
          "half_point",
          "zero_points",
          "full_point"
        ],
        "default": "half_point"
      },
      "EliminationSettings": {
        "type": "object",
        "properties": {
          "startWeek": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "regular"
                ]
              },
              "number": {
                "type": "integer",
                "minimum": 1,
                "maximum": 18
              }
            },
            "required": [
              "type",
              "number"
            ]
          },
          "endWeek": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "regular"
                ]
              },
              "number": {
                "type": "integer",
                "minimum": 1,
                "maximum": 18
              }
            },
            "required": [
              "type",
              "number"
            ]
          },
          "pickType": {
            "$ref": "#/components/schemas/PickType"
          },
          "pushTieResolution": {
            "$ref": "#/components/schemas/EliminationPushTieResolution"
          }
        },
        "required": [
          "startWeek",
          "endWeek",
          "pickType"
        ]
      },
      "EliminationPushTieResolution": {
        "type": "string",
        "enum": [
          "advance",
          "eliminate"
        ],
        "default": "advance"
      },
      "MemberRole": {
        "type": "string",
        "enum": [
          "commissioner",
          "member"
        ]
      },
      "LeagueMember": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "username": {
            "type": [
              "string",
              "null"
            ]
          },
          "displayName": {
            "type": "string"
          },
          "image": {
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "$ref": "#/components/schemas/MemberRole"
          },
          "joinedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "userId",
          "username",
          "displayName",
          "image",
          "role",
          "joinedAt"
        ]
      },
      "CreateLeagueRequest": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "pickem"
                ]
              },
              "name": {
                "$ref": "#/components/schemas/LeagueName"
              },
              "visibility": {
                "$ref": "#/components/schemas/LeagueVisibility"
              },
              "settings": {
                "$ref": "#/components/schemas/PickemSettings"
              }
            },
            "required": [
              "mode",
              "name",
              "visibility",
              "settings"
            ]
          },
          {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "elimination"
                ]
              },
              "name": {
                "$ref": "#/components/schemas/LeagueName"
              },
              "visibility": {
                "$ref": "#/components/schemas/LeagueVisibility"
              },
              "settings": {
                "$ref": "#/components/schemas/EliminationSettings"
              }
            },
            "required": [
              "mode",
              "name",
              "visibility",
              "settings"
            ]
          },
          {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "march_madness"
                ]
              },
              "name": {
                "$ref": "#/components/schemas/LeagueName"
              },
              "visibility": {
                "$ref": "#/components/schemas/LeagueVisibility"
              },
              "settings": {
                "$ref": "#/components/schemas/MarchMadnessSettings"
              }
            },
            "required": [
              "mode",
              "name",
              "visibility",
              "settings"
            ]
          }
        ]
      },
      "MarchMadnessSettings": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "maxBracketsPerMember": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10,
                "default": 5
              },
              "scoringModel": {
                "type": "string",
                "enum": [
                  "standard_doubling"
                ]
              }
            },
            "required": [
              "scoringModel"
            ]
          },
          {
            "type": "object",
            "properties": {
              "maxBracketsPerMember": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10,
                "default": 5
              },
              "scoringModel": {
                "type": "string",
                "enum": [
                  "custom"
                ]
              },
              "roundValues": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "required": [
              "scoringModel",
              "roundValues"
            ]
          }
        ]
      },
      "MyLeaguesResponse": {
        "type": "object",
        "properties": {
          "leagues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LeagueSummary"
            }
          }
        },
        "required": [
          "leagues"
        ]
      },
      "LeagueSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "$ref": "#/components/schemas/LeagueName"
          },
          "mode": {
            "$ref": "#/components/schemas/LeagueMode"
          },
          "visibility": {
            "$ref": "#/components/schemas/LeagueVisibility"
          },
          "status": {
            "$ref": "#/components/schemas/LeagueStatus"
          },
          "memberCount": {
            "type": "integer"
          },
          "myRole": {
            "$ref": "#/components/schemas/MemberRole"
          },
          "startsAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "mode",
          "visibility",
          "status",
          "memberCount",
          "myRole",
          "startsAt"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Liveness check",
        "responses": {
          "200": {
            "description": "Service is up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "operationId": "getMe",
        "summary": "Get the caller's own profile",
        "responses": {
          "200": {
            "description": "The caller's profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "No valid session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Server misconfiguration — structurally unreachable outside generate-openapi.ts, which builds the app with no deps and only ever requests the spec document, never invoking this handler.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "updateMe",
        "summary": "Claim/change the caller's username and/or edit their display name",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateMeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profile updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "400": {
            "description": "No fields supplied, or a supplied field fails its format rule",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "No valid session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Username already taken by another user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Server misconfiguration — structurally unreachable outside generate-openapi.ts, which builds the app with no deps and only ever requests the spec document, never invoking this handler.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteMe",
        "summary": "Delete (anonymize) the caller's own account",
        "responses": {
          "204": {
            "description": "Account deleted — profile anonymized, OAuth identities and sessions removed"
          },
          "401": {
            "description": "No valid session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Server misconfiguration — structurally unreachable outside generate-openapi.ts, which builds the app with no deps and only ever requests the spec document, never invoking this handler.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/nfl/sync-schedule": {
      "post": {
        "operationId": "runNflSyncSchedule",
        "summary": "Ingest the NFL schedule (regular season + postseason) into our tables",
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 2000,
              "maximum": 2100
            },
            "required": false,
            "name": "season",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 18
            },
            "required": false,
            "name": "week",
            "in": "query"
          },
          {
            "schema": {
              "$ref": "#/components/schemas/WeekType"
            },
            "required": false,
            "name": "weekType",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Job completed — counters in `details`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobRunResponse"
                }
              }
            }
          },
          "400": {
            "description": "A supplied query param (season/week) fails its format rule",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong x-job-secret header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Job failed, or a dependency is not configured — same envelope either way",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobRunResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/nfl/sync-odds": {
      "post": {
        "operationId": "runNflSyncOdds",
        "summary": "Snapshot spreads for unstarted games in the current NFL week",
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 2000,
              "maximum": 2100
            },
            "required": false,
            "name": "season",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 18
            },
            "required": false,
            "name": "week",
            "in": "query"
          },
          {
            "schema": {
              "$ref": "#/components/schemas/WeekType"
            },
            "required": false,
            "name": "weekType",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Job completed — counters in `details`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobRunResponse"
                }
              }
            }
          },
          "400": {
            "description": "A supplied query param (season/week) fails its format rule",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong x-job-secret header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Job failed, or a dependency is not configured — same envelope either way",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobRunResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/nfl/sync-scores": {
      "post": {
        "operationId": "runNflSyncScores",
        "summary": "Refresh live scores/statuses for in-flight NFL games from the provider",
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 2000,
              "maximum": 2100
            },
            "required": false,
            "name": "season",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 18
            },
            "required": false,
            "name": "week",
            "in": "query"
          },
          {
            "schema": {
              "$ref": "#/components/schemas/WeekType"
            },
            "required": false,
            "name": "weekType",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Job completed — counters in `details`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobRunResponse"
                }
              }
            }
          },
          "400": {
            "description": "A supplied query param (season/week) fails its format rule",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong x-job-secret header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Job failed, or a dependency is not configured — same envelope either way",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobRunResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/leagues": {
      "post": {
        "operationId": "createLeague",
        "summary": "Create a league; the creator becomes a commissioner",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateLeagueRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "League created in a pre-start state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeagueResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid name, mode, visibility, or mode settings",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "No valid session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
