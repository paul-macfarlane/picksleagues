# deps & build
node_modules/
dist/
.vercel/
*.tsbuildinfo

# env
.env
.env.*
!.env.example

# test artifacts
test-results/
playwright-report/
coverage/

# TanStack Router's local scratch dir (generated by the dev server)
.tanstack/

# local review feedback (never committed — see /feedback)
/feedback.md

# os
.DS_Store
.vercel
.env*

# <!-- atlas-v3:gitignore:start -->
# The markers above and below are Atlas's block delimiters. They are commented
# because `#` is gitignore's comment character — uncommented, git parses them as
# literal patterns. Atlas detects its markers by substring, so the `# ` prefix is
# safe and the block stays team-owned across scaffold reruns.
.claude/worktrees/
.claude/atlas-state/
# Re-include committed PASS evidence, which the `test-results/` rule above would
# otherwise swallow. The directory negation must precede the `/**` negation.
!docs/evidence/test-results/
!docs/evidence/test-results/**
# <!-- atlas-v3:gitignore:end -->

# ...but not images or video: those are attached to the pull request, where they
# render inline for the reviewer, and they are the one artifact that can't be
# removed later without rewriting history. Text evidence stays committed
# (docs/agents/testing.md §Evidence policy). Deliberately outside the Atlas block
# above so a scaffold rerun can't drop it, and after it so these rules win.
docs/evidence/test-results/**/*.png
docs/evidence/test-results/**/*.jpg
docs/evidence/test-results/**/*.jpeg
docs/evidence/test-results/**/*.gif
docs/evidence/test-results/**/*.webp
docs/evidence/test-results/**/*.webm
docs/evidence/test-results/**/*.mp4
docs/evidence/test-results/**/*.zip

# Python bytecode (Atlas hooks are Python; everything else here is TS)
__pycache__/
*.py[cod]
