{
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --no-verify*)",
      "Bash(git commit --no-verify*)",
      "Bash(gh pr merge*)",
      "Bash(glab mr merge*)",
      "Bash(terraform apply*)",
      "Bash(*terraform apply*)",
      "Bash(terraform destroy*)",
      "Bash(*terraform destroy*)",
      "Bash(cdk deploy*)",
      "Bash(*cdk deploy*)",
      "Bash(cdk destroy*)",
      "Bash(*cdk destroy*)",
      "Bash(kubectl apply*)",
      "Bash(*kubectl apply*)",
      "Bash(git push origin staging*)",
      "Bash(git push -u origin staging*)",
      "Bash(git push origin main*)",
      "Bash(git push -u origin main*)"
    ],
    "ask": ["Bash(git worktree remove*)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-destructive.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "playwright@claude-plugins-official": true
  }
}
