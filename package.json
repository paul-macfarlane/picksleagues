{
  "name": "picksleagues",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "pnpm --parallel --filter @picksleagues/web --filter @picksleagues/api dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present test",
    "db:up": "docker compose up -d db --wait",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @picksleagues/db generate",
    "db:migrate": "pnpm --filter @picksleagues/db migrate",
    "contract:generate": "pnpm --filter @picksleagues/api generate:openapi",
    "contract:check": "pnpm contract:generate && git diff --exit-code -- openapi || (echo 'openapi/ is stale: run pnpm contract:generate and commit the result' && exit 1)"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.64.0"
  }
}
