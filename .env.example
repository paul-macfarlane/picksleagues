# Copy to .env for local development. All vars are validated at startup
# (packages/core/src/env.ts) — the app refuses to boot with a bad config.

# local | staging | production — gates simulator/admin surfaces. Sim routes are
# not registered at all when production.
APP_ENV=local

# true | false — explicit simulator toggle (simulated clock, sim fixtures,
# /api/sim/* routes). Defaults to false when unset. Production ignores it: with
# APP_ENV=production the simulator is off no matter what this says.
SIM_ENABLED=true

# Local Docker Postgres (docker-compose.yml). Staging/prod use Neon URLs and
# must spell sslmode=verify-full — Neon's default sslmode=require is rejected
# at boot because pg v9 downgrades it to weaker semantics (see env.ts).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/picksleagues

# Better Auth. Secret: `openssl rand -base64 32`. URL must be the SPA origin
# (:5173 locally — the Vite proxy makes web+api same-origin, and the session
# cookie must be scoped where the SPA can see it).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173

# Per-environment OAuth apps (arch §Environments); redirect URI is
# <BETTER_AUTH_URL>/api/auth/callback/<provider>.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Shared secret required by /api/jobs/* and /api/sim/* endpoints.
JOB_SECRET=

# Admin capability is not configured here — it lives in users.app_role. Grant it
# with a direct database update:
#   UPDATE users SET app_role = 'admin' WHERE email = 'you@example.com';
